<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.ym.mapper.YmBatchMapper">

    <resultMap type="com.ruoyi.ym.domain.YmBatch" id="YmBatchResult">
        <id     property="id"           column="id" />
        <result property="batchNo"      column="batch_no" />
        <result property="name"         column="name" />
        <result property="productType"  column="product_type" />
        <result property="origin"       column="origin" />
        <result property="processor"    column="processor" />
        <result property="warehouse"    column="warehouse" />
        <result property="harvestDate"  column="harvest_date" />
        <result property="processDate"  column="process_date" />
        <result property="pickDate"     column="pick_date" />
        <result property="videoUrl"     column="video_url" />
        <result property="lawyerName"   column="lawyer_name" />
        <result property="remark"       column="remark" />
        <result property="status"       column="status" />
        <result property="createdAt"    column="created_at" />
        <result property="updatedAt"    column="updated_at" />
    </resultMap>

    <sql id="selectVo">
        select id, batch_no, name, product_type, origin, processor, warehouse, harvest_date, process_date,
               pick_date, video_url, lawyer_name, remark, status, created_at, updated_at
        from ym_batches
    </sql>

    <select id="selectYmBatchList" resultMap="YmBatchResult">
        <include refid="selectVo"/>
        <where>
            <if test="batchNo != null and batchNo != ''">AND batch_no like concat('%', #{batchNo}, '%')</if>
            <if test="name != null and name != ''">AND name like concat('%', #{name}, '%')</if>
            <if test="productType != null and productType != ''">AND product_type = #{productType}</if>
            <if test="origin != null and origin != ''">AND origin like concat('%', #{origin}, '%')</if>
            <if test="lawyerName != null and lawyerName != ''">AND lawyer_name like concat('%', #{lawyerName}, '%')</if>
            <if test="status != null">AND status = #{status}</if>
        </where>
        order by id desc
    </select>

    <select id="selectYmBatchById" resultMap="YmBatchResult">
        <include refid="selectVo"/> where id = #{id}
    </select>

    <select id="selectYmBatchByBatchNo" resultMap="YmBatchResult">
        <include refid="selectVo"/> where batch_no = #{batchNo} limit 1
    </select>

    <insert id="insertYmBatch" useGeneratedKeys="true" keyProperty="id">
        insert into ym_batches
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="batchNo != null">batch_no,</if>
            <if test="name != null">name,</if>
            <if test="productType != null">product_type,</if>
            <if test="origin != null">origin,</if>
            <if test="processor != null">processor,</if>
            <if test="warehouse != null">warehouse,</if>
            <if test="harvestDate != null">harvest_date,</if>
            <if test="processDate != null">process_date,</if>
            <if test="pickDate != null">pick_date,</if>
            <if test="videoUrl != null">video_url,</if>
            <if test="lawyerName != null">lawyer_name,</if>
            <if test="remark != null">remark,</if>
            <if test="status != null">status,</if>
            created_at,
            updated_at,
        </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="batchNo != null">#{batchNo},</if>
            <if test="name != null">#{name},</if>
            <if test="productType != null">#{productType},</if>
            <if test="origin != null">#{origin},</if>
            <if test="processor != null">#{processor},</if>
            <if test="warehouse != null">#{warehouse},</if>
            <if test="harvestDate != null">#{harvestDate},</if>
            <if test="processDate != null">#{processDate},</if>
            <if test="pickDate != null">#{pickDate},</if>
            <if test="videoUrl != null">#{videoUrl},</if>
            <if test="lawyerName != null">#{lawyerName},</if>
            <if test="remark != null">#{remark},</if>
            <if test="status != null">#{status},</if>
            sysdate(),
            sysdate(),
        </trim>
    </insert>

    <update id="updateYmBatch">
        update ym_batches
        <trim prefix="SET" suffixOverrides=",">
            <if test="batchNo != null">batch_no = #{batchNo},</if>
            <if test="name != null">name = #{name},</if>
            <if test="productType != null">product_type = #{productType},</if>
            <if test="origin != null">origin = #{origin},</if>
            <if test="processor != null">processor = #{processor},</if>
            <if test="warehouse != null">warehouse = #{warehouse},</if>
            <if test="harvestDate != null">harvest_date = #{harvestDate},</if>
            <if test="processDate != null">process_date = #{processDate},</if>
            <if test="pickDate != null">pick_date = #{pickDate},</if>
            <if test="videoUrl != null">video_url = #{videoUrl},</if>
            <if test="lawyerName != null">lawyer_name = #{lawyerName},</if>
            <if test="remark != null">remark = #{remark},</if>
            <if test="status != null">status = #{status},</if>
            updated_at = sysdate(),
        </trim>
        where id = #{id}
    </update>

    <delete id="deleteYmBatchByIds">
        delete from ym_batches where id in
        <foreach item="id" collection="array" open="(" separator="," close=")">#{id}</foreach>
    </delete>
</mapper>
